# 安装只产生文件，不初始化实例、不下载Web、不修改主机服务。
set(ANOF_WEB_DIST "" CACHE PATH "Explicit prebuilt Web dist (empty installs CLI/server only)")
if(NOT ANOF_ENABLE_INSTALL)
    return()
endif()
include(GNUInstallDirs)
if(IS_ABSOLUTE "${CMAKE_INSTALL_LIBDIR}" OR IS_ABSOLUTE "${CMAKE_INSTALL_BINDIR}")
    message(FATAL_ERROR "ANOF runtime relocation requires relative bindir/libdir")
endif()
if(NOT SQLite3_LIBRARY MATCHES "\\.so(\\.[0-9.]+)?$" OR NOT EXISTS "${SQLite3_LIBRARY}")
    message(FATAL_ERROR "ANOF installation requires an explicit shared SQLite3_LIBRARY")
endif()
if(ANOF_BUNDLE_SQLITE)
    # 官方独立前缀库可能没有SONAME，不能把构建机绝对路径写入DT_NEEDED。
    set_property(TARGET SQLite::SQLite3 PROPERTY IMPORTED_NO_SONAME TRUE)
    get_filename_component(anof_sqlite_name "${SQLite3_LIBRARY}" NAME)
    file(REAL_PATH "${SQLite3_LIBRARY}" anof_sqlite_file)
    execute_process(COMMAND "${CMAKE_READELF}" -d "${SQLite3_LIBRARY}"
        OUTPUT_VARIABLE anof_sqlite_dynamic RESULT_VARIABLE anof_sqlite_status)
    if(NOT anof_sqlite_status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect selected SQLite ELF library")
    endif()
    if(anof_sqlite_dynamic MATCHES "\\(SONAME\\)[^\n]*\\[([^]]+)\\]")
        set(anof_sqlite_name "${CMAKE_MATCH_1}")
    endif()
    file(RELATIVE_PATH anof_lib_relative "/${CMAKE_INSTALL_BINDIR}" "/${CMAKE_INSTALL_LIBDIR}/anof")
    set_target_properties(anof PROPERTIES INSTALL_RPATH "$ORIGIN/${anof_lib_relative}" INSTALL_RPATH_USE_LINK_PATH FALSE)
    install(FILES "${anof_sqlite_file}" DESTINATION "${CMAKE_INSTALL_LIBDIR}/anof" RENAME "${anof_sqlite_name}" COMPONENT Runtime)
else()
    # 源码安装可使用指定外部库；独立前缀须保持可访问，不修改全局加载路径。
    get_filename_component(anof_sqlite_directory "${SQLite3_LIBRARY}" DIRECTORY)
    set_target_properties(anof PROPERTIES INSTALL_RPATH "${anof_sqlite_directory}" INSTALL_RPATH_USE_LINK_PATH FALSE)
endif()
install(TARGETS anof RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT Runtime)
install(FILES CHANGELOG.md SECURITY.md DESTINATION "${CMAKE_INSTALL_DATADIR}/anof" COMPONENT Runtime)
install(FILES LICENSE DESTINATION "${CMAKE_INSTALL_DATADIR}/anof/licenses" COMPONENT Runtime)
install(FILES third_party/muduox/License DESTINATION "${CMAKE_INSTALL_DATADIR}/anof/licenses" RENAME muduox-LICENSE COMPONENT Runtime)
install(DIRECTORY deploy/ DESTINATION "${CMAKE_INSTALL_DATADIR}/anof/deploy" COMPONENT Runtime
    PATTERN AGENTS.md EXCLUDE)
install(DIRECTORY deploy/licenses/ DESTINATION "${CMAKE_INSTALL_DATADIR}/anof/licenses" COMPONENT Runtime)
if(ANOF_WEB_DIST)
    if(NOT IS_ABSOLUTE "${ANOF_WEB_DIST}" OR NOT EXISTS "${ANOF_WEB_DIST}/index.html"
       OR NOT EXISTS "${ANOF_WEB_DIST}/THIRD_PARTY_NOTICES.txt" OR NOT IS_DIRECTORY "${ANOF_WEB_DIST}/assets")
        message(FATAL_ERROR "ANOF_WEB_DIST must be an absolute prebuilt dist with index/assets/NOTICE")
    endif()
    install(FILES "${ANOF_WEB_DIST}/index.html" "${ANOF_WEB_DIST}/THIRD_PARTY_NOTICES.txt"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/anof/web" COMPONENT Runtime)
    install(DIRECTORY "${ANOF_WEB_DIST}/assets/" DESTINATION "${CMAKE_INSTALL_DATADIR}/anof/web/assets"
        COMPONENT Runtime FILES_MATCHING PATTERN "*.js" PATTERN "*.css" PATTERN "*.wasm")
endif()
